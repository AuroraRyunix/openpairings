{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/teapot-chess/openpairings/main/priv/contracts/manubrium-v1/player-create-request.schema.json",
  "title": "POST /tournaments/:id/players request",
  "description": "A player typed in, or one picked from a list (`from`). Fields outside the list are ignored.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "player"
  ],
  "properties": {
    "player": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "from"
          ],
          "properties": {
            "from": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "source",
                    "fide_id"
                  ],
                  "properties": {
                    "source": {
                      "const": "fide"
                    },
                    "fide_id": {
                      "$ref": "common.schema.json#/definitions/id"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "source",
                    "national_id"
                  ],
                  "properties": {
                    "source": {
                      "const": "bel"
                    },
                    "national_id": {
                      "type": [
                        "string",
                        "integer"
                      ]
                    }
                  }
                }
              ]
            },
            "start_round": {
              "type": [
                "integer",
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "not": {
            "required": [
              "from"
            ]
          },
          "required": [
            "name"
          ],
          "additionalProperties": true,
          "properties": {
            "name": {
              "type": "string"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "sex": {
              "type": [
                "string",
                "null"
              ]
            },
            "fide_id": {
              "type": [
                "integer",
                "string",
                "null"
              ]
            },
            "fide_rating": {
              "type": [
                "integer",
                "string",
                "null"
              ]
            },
            "national_rating": {
              "type": [
                "integer",
                "string",
                "null"
              ]
            },
            "federation": {
              "type": [
                "string",
                "null"
              ]
            },
            "club": {
              "type": [
                "string",
                "null"
              ]
            },
            "birth_year": {
              "type": [
                "integer",
                "string",
                "null"
              ]
            },
            "start_round": {
              "type": [
                "integer",
                "string",
                "null"
              ]
            }
          }
        }
      ]
    }
  }
}
