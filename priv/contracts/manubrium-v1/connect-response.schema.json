{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/teapot-chess/openpairings/main/priv/contracts/manubrium-v1/connect-response.schema.json",
  "title": "POST /connect response (201)",
  "description": "The device token, shown once, and who it belongs to. Every later request sends `Authorization: Bearer <token>`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token",
    "device",
    "user",
    "server"
  ],
  "properties": {
    "token": {
      "type": "string",
      "pattern": "^mnb_"
    },
    "device": {
      "$ref": "common.schema.json#/definitions/device"
    },
    "user": {
      "$ref": "common.schema.json#/definitions/user"
    },
    "server": {
      "$ref": "common.schema.json#/definitions/server"
    }
  }
}
