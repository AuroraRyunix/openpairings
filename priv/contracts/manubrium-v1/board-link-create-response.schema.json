{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/teapot-chess/openpairings/main/priv/contracts/manubrium-v1/board-link-create-response.schema.json",
  "title": "POST /tournaments/:id/board-links response (201)",
  "description": "The code as listed, and the full connect code (<root>#oplt_...) the box scans: shown this once.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "link",
    "code"
  ],
  "properties": {
    "link": {
      "$ref": "common.schema.json#/definitions/board_link"
    },
    "code": {
      "type": "string",
      "pattern": "^https?://[^#]+/api/boards/v1#oplt_"
    }
  }
}
