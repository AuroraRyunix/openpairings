msgstr "Formulier openen"

#: lib/pairings_engine_web/live/settings_results_live.ex:416
#: lib/pairings_engine_web/live/settings_support.ex:69
#, elixir-autogen, elixir-format
msgid "OpenResults"
msgstr "OpenResults"

#: lib/pairings_engine_web/live/pairings_live.ex:1593
#: lib/pairings_engine_web/live/standings_live.ex:347
#, elixir-autogen, elixir-format
