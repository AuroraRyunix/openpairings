#: lib/pairings_engine_web/live/tournaments_live.ex:2619
#, elixir-autogen, elixir-format
msgid "Postponed games still to be played - the standings are provisional"
msgstr "Uitgestelde partijen nog te spelen - de stand is voorlopig"

#: lib/pairings_engine_web/live/print_live.ex:38
#, elixir-autogen, elixir-format
msgid "Postponed-game notices"
msgstr "Briefjes voor uitgestelde partijen"

#: lib/pairings_engine_web/live/pairings_live.ex:3427
#, elixir-autogen, elixir-format
msgid "Print notices"
msgstr "Briefjes afdrukken"

#: lib/pairings_engine_web/live/players_live.ex:2364
#, elixir-autogen, elixir-format
