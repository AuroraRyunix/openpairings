<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The application manifest for OpenPairings.exe, embedded as resource type 24.

  Common-Controls 6.0 is the reason this file exists: without the dependency
  below, a plain BUTTON is drawn by the Windows 95 control set. The window this
  launcher shows is the only OpenPairings window that is not a web page, so it
  is the only one that can look like abandonware.

  dpiAware=true is system DPI awareness, not per-monitor. Per-monitor would
  need WM_DPICHANGED handling for a fixed-size status window that nobody drags
  between monitors; system awareness is crisp where it matters and has no code
  behind it.

  asInvoker, explicitly: the whole install is per-user under %LOCALAPPDATA% and
  must never raise a UAC prompt. Federation-managed laptops do not hand out
  administrator rights, and an installer that asks for them is an installer
  that does not get run.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="OpenPairings.Launcher" version="1.0.0.0"
                    processorArchitecture="*"/>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
                        version="6.0.0.0" processorArchitecture="*"
                        publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>
</assembly>
