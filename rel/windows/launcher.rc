/*
 * Resources for OpenPairings.exe. Compiled by `zig rc` from build_launcher.ps1.
 *
 * launcher_version.h is GENERATED by that script from the version in mix.exs,
 * so the executable's Properties page cannot drift from the release it starts.
 * It is not committed; the script writes it into the build directory and
 * passes that directory with /i.
 *
 * Three resources, and each earns its place:
 *
 *   1 ICON      - without it the taskbar shows the generic "unknown program"
 *                 icon, which is the first thing anybody sees.
 *   1 24        - the application manifest (RT_MANIFEST is resource type 24;
 *                 the number avoids depending on a header for one constant).
 *                 It asks for Common Controls 6, which is the difference
 *                 between buttons that look like this decade's Windows and
 *                 buttons that look like Windows 95.
 *   VERSIONINFO - Properties shows a name and a version. An unsigned binary
 *                 with no version information at all also reads to a heuristic
 *                 antivirus engine as one more thing a dropper does not
 *                 bother with; this costs nothing and removes the tell.
 */

#include "launcher_version.h"

1 ICON "OpenPairings.ico"

1 24 "launcher.manifest"

1 VERSIONINFO
FILEVERSION OP_VER_MAJOR, OP_VER_MINOR, OP_VER_PATCH, 0
PRODUCTVERSION OP_VER_MAJOR, OP_VER_MINOR, OP_VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenPairings"
            VALUE "FileDescription", "OpenPairings - chess tournament manager"
            VALUE "FileVersion", OP_VER_STRING
            VALUE "InternalName", "OpenPairings"
            VALUE "OriginalFilename", "OpenPairings.exe"
            VALUE "ProductName", "OpenPairings"
            VALUE "ProductVersion", OP_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
