<!DOCTYPE html>
<html lang={Gettext.get_locale(PairingsEngineWeb.Gettext)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="OpenPairings" suffix=" · OpenPairings" phx-no-format>{assigns[:page_title]}</.live_title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml;base64,"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Runs before first paint (a deferred bundle would flash the wrong
          theme), so it stays inline and carries the response's CSP nonce. --%>
    <script nonce={PairingsEngineWeb.CSP.nonce()}>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        // localStorage THROWS (not returns null) in a third-party frame when
        // the browser blocks or partitions storage - Safari's default, and
        // Chrome with third-party cookies disabled. Unguarded, that kills
        // this whole bootstrap and the page renders with no theme and no
        // accent at all, in exactly the embedded case the default below
        // exists to serve.
        const store = {
          get: (k) => { try { return localStorage.getItem(k); } catch (_) { return null; } },
          set: (k, v) => { try { localStorage.setItem(k, v); } catch (_) {} },
          remove: (k) => { try { localStorage.removeItem(k); } catch (_) {} },
        };

        // An embedded page defaults to LIGHT rather than following the
        // visitor's OS setting. The frame is a panel inside somebody else's
        // page, which is overwhelmingly light, and a dark slab dropped into
        // the middle of a club's white site reads as broken rather than as a
        // theme. Comparing `self`/`top` is safe cross-origin - the reference
        // comparison is allowed, only reading top's PROPERTIES would throw.
        //
        // Only the DEFAULT changes. An explicit pick from the theme switch
        // still wins and still persists, including inside the frame (where
        // partitioned storage scopes it to that one embedding site).
        const embedded = window.self !== window.top;
        const defaultTheme = () => embedded ? "embed" : "system";

        const applyTheme = (theme, source) => {
          document.documentElement.setAttribute("data-theme", theme);
          document.documentElement.setAttribute("data-theme-source", source);
        };

        // A theme that changed its NAME rather than disappearing. Catppuccin
        // became Mocha - same palette, so whoever had it picked did not ask
        // to lose it and should land on the new name, not be bounced to
        // System like a theme that is actually gone. Applied before the
        // `known` check below, so the old key still resolves to a real
        // theme instead of failing it.
        const aliases = { catppuccin: "mocha" };

        // Every palette app.css actually defines, and the only strings that
        // may reach `data-theme` once the alias above has run. A stored
        // choice is a string in somebody else's browser: it outlives the
        // theme it names. Solarized Dark, Solarized Light, Nord and
        // Nocturne were removed while people were using them, and without
        // this list their next visit would have stamped e.g.
        // `data-theme="nord"` on a document where no such block exists -
        // :root's LIGHT palette, rendered under every assumption a dark
        // theme makes, which looks like the app is broken rather than like
        // a theme was retired.
        //
        // An unknown value therefore falls back to the default (System),
        // and the stale key is dropped so the fallback is not re-decided on
        // every page. Losing a theme should cost the person who liked it a
        // trip back to the picker, nothing more.
        const known = new Set([
          "light", "dark", "slate", "mocha", "paper", "board", "contrast"
        ]);

        const setTheme = (theme) => {
          theme = aliases[theme] || theme;
          if (theme !== "system" && theme !== "embed" && !known.has(theme)) {
            store.remove("phx:theme");
            theme = defaultTheme();
          }
          if (theme === "system") {
            store.remove("phx:theme");
            applyTheme(systemTheme(), "system");
          } else if (theme === "embed") {
            // Deliberately NOT persisted. Writing it would make the default
            // indistinguishable from the visitor having chosen light, and
            // would freeze it for them if this default ever changes.
            applyTheme("light", "embed");
          } else {
            store.set("phx:theme", theme);
            applyTheme(theme, "user");
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(store.get("phx:theme") || defaultTheme());
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || defaultTheme()));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        // Only a page actually following the OS tracks OS changes - an
        // embedded default of light must stay light when the visitor's
        // machine flips to dark at sunset.
        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });

        // Accent colour - independent of light/dark. Default "green".
        const setAccent = (accent) => {
          accent = accent || "green";
          store.set("phx:accent", accent);
          document.documentElement.setAttribute("data-accent", accent);
        };
        setAccent(store.get("phx:accent"));
        window.addEventListener("storage", (e) => e.key === "phx:accent" && setAccent(e.newValue));
        window.addEventListener("phx:set-accent", (e) => setAccent(e.target.dataset.phxAccent));
      })();
    </script>
  </head>
  <body>
    <%!-- Pending-restart warning, announced by the deploy script shortly
          before it restarts the service.

          It lives HERE, in the root layout, rather than in `Layouts.app`,
          because that is a function component: it
          receive only the attributes each page passes them, not the
          LiveView's assigns. Threading the deadline through would mean
          touching 29 call sites, and a call site missed later shows no
          warning at all - which looks exactly like no deploy pending.

          So it is rendered once, empty, on every page, and driven entirely
          by the `phx:deploy-notice` event the DeployNotice hook pushes.
          The countdown and the escalation both run in the browser (see
          assets/js/app.js), so the server never sends a per-second message
          to every open socket. --%>
    <div id="deploy-banner" class="deploy-banner" role="status" aria-live="polite" hidden>
      <strong class="deploy-banner-lead">Server update</strong>
      <span class="deploy-banner-text"></span>
    </div>
    <%!-- A plain announcement, set by hand and taken down by hand - see
          PairingsEngine.Notice. Separate from the banner above because it
          means something different: nothing is about to restart, nobody
          needs to save anything, and it does not count down. Sharing that
          element would have meant sharing its escalation and its wording. --%>
    <div id="site-notice" class="site-notice" role="status" aria-live="polite" hidden>
      <strong class="site-notice-lead">Notice</strong>
      <span class="site-notice-text"></span>
    </div>
    <%!-- Shown once, after a restart, when the version the browser last saw
          is not the version now running. The comparison is client-side
          because only the browser remembers what it saw BEFORE the restart -
          the server that knew has been replaced. --%>
    <div id="version-toast" class="version-toast" role="status" aria-live="polite" hidden>
      <span class="version-toast-text"></span>
      <button type="button" class="version-toast-close" aria-label={gettext("Dismiss")}>&times;</button>
    </div>
    {@inner_content}
  </body>
</html>
